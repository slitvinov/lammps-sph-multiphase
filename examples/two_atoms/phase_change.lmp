# Compare heat conduction from LAMMPS and from maxima
# (phase_change.lmp)
# To run this test:
#
# maxima -b phase_change.mac
# ../../../../src/lmp_linux -in phase_change.lmp
#
# To see the output 
# head output.dat

echo               both
dimension          3
units              si
atom_modify        map array sort 0 0
# requires a custom version of LAMMPS
# https://github.com/slitvinov/lammps-sph-multiphase
# Built with
# make yes-USER-SPH
# 
# See also
# http://lammps.sandia.gov/doc/Section_start.html#start_3
atom_style         sph
comm_modify    vel yes

#2D box
# domain size
variable          Lx equal 10
# smothing length
variable          h equal 1
variable          alpha equal 1.0

variable          nLx equal -${Lx}
region             box block 0 ${Lx} 0 ${Lx} ${nLx} ${Lx} units box

create_box         2 box
mass               * 1.0
fix                mp all property/atom rmass d2_cg 3 ghost yes

# run 
# maxima -b phase_change.mac
# to get this file
include           in.atoms

set               type 1         mass 10
set               type 2         mass 2

set               type 1         sph/rho 1
set               type 2         sph/rho 1

set               type 1  sph/e 10.0
set               type 2  sph/e 2.0

set               type 1  sph/cv 3.0
set               type 2  sph/cv 1.0

variable          Tc      equal 1
variable         Hwv      equal 1
variable          dr      equal 1
variable          to_mass equal 1
variable          pcutoff equal 1
variable          from_type equal 1
variable          to_type   equal 2
variable          insert_every equal 1
variable          prob     equal 1

pair_style        sph/colorgradient 1
pair_style         sph/colorgradient 1
pair_coeff         1 1     ${h} 0
pair_coeff         2 2     ${h} 0
pair_coeff         1 2     ${h} ${alpha}

fix                fdep all phase_change &
                   ${Tc} ${Tc} ${Hwv} ${dr} ${to_mass} &
                   ${pcutoff} ${from_type} ${to_type} ${insert_every} 123456 ${prob} &
		   region box units box

# do full time integration
fix                integrate_fix_full all  sph
compute         e_atom all sph/e/atom
variable           e_atom atom c_e_atom
compute         de_atom all sph/de/atom
variable           de_atom atom c_de_atom
compute         t_atom all  sph/t/atom

variable           t_atom atom c_t_atom
neighbor           0 bin
timestep           0

dump              dump_txt all custom 1 dump.*.dat id type x y z vx vy vy mass c_e_atom c_de_atom

fix extra all print 1 &
"$(v_de_atom[1]) $(v_de_atom[2]) $(v_t_atom[1]) $(v_t_atom[2])" &
file output.dat screen no
run                1
