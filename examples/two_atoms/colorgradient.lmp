echo               both
dimension          3
units              si
atom_modify        map array sort 0 0
atom_style         sph
comm_modify    vel yes

#2D box
# domain size
variable          Lx equal 10
# smothing length
variable          h equal 1

variable          alpha equal 1.0

variable          nLx equal -${Lx}
region             box block 0 ${Lx} 0 ${Lx} ${nLx} ${Lx} units box

create_box         2 box
mass               * 1.0
fix                mp all property/atom rmass d2_cg 3 ghost yes

# run 
# maxima -b surfacetension.mac
# to get this file
include           in.atoms

set               type 1         mass 2
set               type 2         mass 1

set               type 1         sph/rho 1
set               type 2         sph/rho 1

pair_style         sph/colorgradient 1
pair_coeff         1 1     ${h} 0
pair_coeff         2 2     ${h} 0
pair_coeff         1 2     ${h} ${alpha}

# do full time integration
fix                integrate_fix_full all  sph
variable           colorgradient_peratom atom sqrt(d2_cg[1]^2+d2_cg[2]^2+d2_cg[3]^2)

neighbor           0 bin
timestep           0

fix extra all print 1 "$(v_colorgradient_peratom[1]) $(v_colorgradient_peratom[2])" file outpt.dat screen no
run                1

